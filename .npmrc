# Keep package-lock.json registry-neutral: no download URLs are stored, so each machine
# uses its own configured registry (a local mirror on a work machine, the public npm
# registry on Vercel and GitHub Actions).
omit-lockfile-registry-resolved=true

# Install peer dependencies the same way everywhere, whatever a user-level .npmrc says,
# so `npm ci` on CI accepts the lockfile made locally.
legacy-peer-deps=false
