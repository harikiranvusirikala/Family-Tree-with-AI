# Copy to .env.local and fill in. Never commit real values.
# Each value is needed from the build step noted (see BUILD_PLAN.md), and every
# variable is described in ARCHITECTURE.md §13.

# --- Database (step 3) ---
# Atlas connection string for a user with read/write on one database.
MONGODB_URI=
# familytree_dev locally; Vercel uses familytree (Production) and familytree_preview (Preview).
MONGODB_DB=familytree_dev

# --- Sign-in (step 4) ---
# Random, at least 32 bytes, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Photos (step 7) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI chat (step 9) ---
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
CHAT_DAILY_LIMIT=50

# --- Tests only. Never set these on Vercel. ---
# Enables the test-only sign-in used by Playwright (step 4).
E2E_TEST_LOGIN=
