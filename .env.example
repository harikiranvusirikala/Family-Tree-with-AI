# Copy to .env.local and fill in. Never commit real values.
# Each value is needed from the build step noted (see BUILD_PLAN.md), and every
# variable is described in ARCHITECTURE.md §13.

# --- Database (step 3) ---
# Atlas connection string for a user with read/write on one database.
MONGODB_URI=
# familytree_dev locally; Vercel uses familytree (Production) and familytree_preview (Preview).
MONGODB_DB=familytree_dev

# --- Sign-in (step 4) ---
# Random, at least 32 bytes, e.g. `openssl rand -base64 32`. Different in Production and Preview.
BETTER_AUTH_SECRET=
# Locally and in Production only. Previews use Vercel's VERCEL_BRANCH_URL and VERCEL_URL.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vercel only (Production and Preview, the same value in both): Google sign-in on previews goes
# through production (ARCHITECTURE.md §12). Not needed locally.
OAUTH_PROXY_SECRET=

# --- Photos (step 7) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI chat (step 9) ---
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
CHAT_DAILY_LIMIT=50
