# Copy to .env.local and fill in. Never commit real values.
# Each value is needed from the build step noted (see docs/BUILD_PLAN.md), and every
# variable is described in docs/ARCHITECTURE.md §13.

# --- Database (step 3) ---
# Atlas connection string for a user with read/write on one database.
MONGODB_URI=
# familytree_dev locally; Vercel uses familytree (Production) and familytree_preview (Preview).
MONGODB_DB=familytree_dev

# --- Sign-in (step 4) ---
# Random, at least 32 bytes, e.g. `openssl rand -base64 32`. Different in Production and Preview.
BETTER_AUTH_SECRET=
# Locally and in Production only. Previews use Vercel's VERCEL_BRANCH_URL and VERCEL_URL.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vercel only (Production and Preview, the same value in both): Google sign-in on previews goes
# through production (docs/ARCHITECTURE.md §12). Not needed locally.
OAUTH_PROXY_SECRET=

# --- Photos (step 7) ---
# Cloudinary Console → Settings → API Keys. The same account in Production and Preview.
# Without them, cards show initials and there are no photo buttons.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI chat (step 9) ---
# An Anthropic API key for the chat. Not named ANTHROPIC_API_KEY: a Claude Code session that loads
# this file would use that name for itself. Without it, there's no "Ask AI".
CHAT_API_KEY=
CHAT_MODEL=claude-haiku-5-5
# Messages per person per day, across all groups.
CHAT_DAILY_LIMIT=50

# --- Backups (step 11) ---
# Not needed here: the nightly workflow (.github/workflows/backup.yml) has them as GitHub secrets.
# `npm run restore` asks for the key; set both only to run `npm run backup` by hand.
# MONGODB_BACKUP_URI=   a database user with only read on familytree
# BACKUP_ENCRYPTION_KEY=   openssl rand -base64 32; also keep it in your password manager
